NODE_ENV=development
PORT=5080
MONGODB_URI=mongodb://127.0.0.1:27017/primespace_ipfm

# Change all secrets in production
JWT_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
ENCRYPTION_KEY=change-me-32-characters-minimum!!

# Comma-separated list of allowed frontend origins
CLIENT_URLS=http://localhost:5173

# API key used by biometric / face-recognition devices (POST /api/v1/attendance/device-punches)
DEVICE_API_KEY=dev-device-key

# Set RUN_JOBS=false when running the scheduler separately with `npm run worker`
RUN_JOBS=true
# Allows "Reset demo data" from the Admin screen
DEMO_MODE=true

# Optional SMTP. Without it, emails are printed to the console.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=PrimeSpace IPFM <no-reply@primespace.local>

# File storage. Without S3_BUCKET files are stored in ./uploads. Links to files expire (signed).
SIGNED_URL_TTL_SEC=21600
S3_BUCKET=
S3_REGION=ap-south-1
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false

# Phone push notifications. Leave empty to auto-generate keys (stored in the database).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@primespace.local

# SMS / WhatsApp: console (log only), twilio, or webhook (POST JSON to your own gateway relay)
SMS_PROVIDER=console
SMS_FROM=
WHATSAPP_PROVIDER=console
WHATSAPP_FROM=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
MESSAGE_WEBHOOK_URL=
MESSAGE_WEBHOOK_TOKEN=
DEFAULT_COUNTRY_CODE=91

# Email-to-ticket: secret token for POST /api/v1/inbound/email?token=...
INBOUND_EMAIL_TOKEN=
